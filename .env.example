# Core bot identity
CHAT_BOT_USER_NAME=euro-travel-assistant

# Slack adapter (auto-read by @chat-adapter/slack)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

# AI Gateway auth
# Preferred in local/dev with `vercel env pull .env.local`
VERCEL_OIDC_TOKEN=
# Optional static fallback for non-OIDC environments
AI_GATEWAY_API_KEY=

# Standalone Node server port
PORT=3000
